# Application Configuration
APP_NAME="Weekly WhatsApp PDF Report Automation System"
DEBUG=false
API_V1_STR="/api/v1"
ADMIN_API_KEY="your-secure-admin-api-key-here"

# Database Configuration
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/whatsapp_reports"

# Meta WhatsApp Business Cloud API Configuration
WHATSAPP_ACCESS_TOKEN="your_meta_whatsapp_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_VERIFY_TOKEN="your_webhook_verification_token"
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_API_BASE_URL="https://graph.facebook.com"
WHATSAPP_MOCK_MODE=false

# Report Configuration
REPORT_STORAGE_PATH="reports/generated"
COMPANY_NAME="Acme Corp Enterprise"

# Scheduler Configuration
REPORT_DAY="MONDAY"
REPORT_TIME="09:00"
REPORT_TIMEZONE="Asia/Kolkata"
WHATSAPP_MAX_RETRIES=3
